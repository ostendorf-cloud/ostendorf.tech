{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ostendorf-tech",
  "type": "object",
  "required": ["image", "service", "existingSecret", "feed"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["type", "port", "adminPort"],
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "annotations": { "type": "object" },
        "parentRefs": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the Gateway this HTTPRoute attaches to. Required when httpRoute.enabled is true; enforced by a template fail guard, not minLength, matching this chart's existing pattern for a value with no usable default."
            },
            "namespace": {
              "type": "string",
              "description": "Namespace the Gateway lives in. Required when httpRoute.enabled is true; see parentRefs.name's own description."
            },
            "sectionName": { "type": "string" }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "config": {
      "type": "object",
      "properties": {
        "listenAddr": { "type": "string", "minLength": 1 },
        "adminListenAddr": { "type": "string", "minLength": 1 },
        "siteUrl": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "trustedProxyCidrs": { "type": "string" },
        "allowPlainHttp": { "type": "boolean" },
        "rateLimitBurst": { "type": "integer", "minimum": 1 },
        "rateLimitPer": { "type": "string" },
        "challengeRateLimitBurst": { "type": "integer", "minimum": 1 },
        "challengeRateLimitPer": { "type": "string" },
        "contactRateLimitBurst": { "type": "integer", "minimum": 1 },
        "contactRateLimitPer": { "type": "string" },
        "mailRateLimitBurst": { "type": "integer", "minimum": 1 },
        "mailRateLimitPer": { "type": "string" },
        "smtpAddr": { "type": "string", "minLength": 1 },
        "contactTo": { "type": "string", "minLength": 1 },
        "contactFrom": { "type": "string", "minLength": 1 },
        "feedRefreshInterval": { "type": "string", "minLength": 1 },
        "umamiUrl": { "type": "string" },
        "umamiWebsiteId": { "type": "string" }
      }
    },
    "existingSecret": {
      "type": "object",
      "required": ["name", "csrfKeyKey"],
      "properties": {
        "name": { "type": "string" },
        "csrfKeyKey": { "type": "string", "minLength": 1 },
        "challengeKeyKey": { "type": "string" },
        "challengeKeyPreviousKey": { "type": "string" },
        "smtpUsernameKey": { "type": "string" },
        "smtpPasswordKey": { "type": "string" }
      }
    },
    "feed": {
      "type": "object",
      "required": ["image", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "annotations": { "type": "object" },
            "name": { "type": "string" }
          }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "openBaoPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "dns": {
              "type": "object",
              "description": "Destination scope for the DNS egress rule, in addition to its port restriction. namespaceSelector and podSelector are each a map of labels (a matchLabels block), not the full Kubernetes LabelSelector shape: this chart has no use for matchExpressions here. Both default to a non-empty value; override either with an explicit null (not {}: Helm merges a map default with an empty override instead of clearing it) to omit that selector from the rule, or both to fall back to a port-only, unscoped rule. Helm merges an override into the default map key by key, so adding a key under a different name than the default (podSelector's default key is k8s-app) leaves the default key in place alongside it; null that specific default key to replace it instead of adding to it.",
              "properties": {
                "namespaceSelector": { "type": "object" },
                "podSelector": { "type": "object" }
              }
            },
            "openBao": {
              "type": "object",
              "description": "Destination scope for the OpenBao egress rule, in addition to its port restriction. Same shape as dns above, including the same per-key merge behaviour for namespaceSelector.",
              "properties": {
                "namespaceSelector": { "type": "object" },
                "podSelector": { "type": "object" }
              }
            }
          }
        },
        "serviceAccountToken": {
          "type": "object",
          "properties": {
            "audience": { "type": "string" },
            "expirationSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "resources": { "type": "object" },
        "startupProbe": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "config": {
          "type": "object",
          "properties": {
            "listenAddr": { "type": "string", "minLength": 1 },
            "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
            "openBaoAddr": {
              "type": "string",
              "description": "The OpenBao address the feed service authenticates against. Required; enforced by a template required guard, not minLength, matching this chart's existing pattern for a value with no usable default."
            },
            "openBaoAuthPath": { "type": "string", "minLength": 1 },
            "openBaoRole": {
              "type": "string",
              "description": "The OpenBao Kubernetes auth role the feed service logs in as. Required; enforced by a template required guard, not minLength; see openBaoAddr's own description."
            },
            "openBaoJwtFile": { "type": "string", "minLength": 1 },
            "tokenPath": { "type": "string", "minLength": 1 },
            "syncInterval": { "type": "string", "minLength": 1 },
            "tokenRefreshAge": { "type": "string", "minLength": 1 },
            "apiVersion": { "type": "string", "minLength": 1 },
            "postCount": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    }
  }
}
