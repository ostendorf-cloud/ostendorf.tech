# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every value below is a placeholder, never a real
# credential.
#
# docker-compose.yaml reads .env for the local development stack; see
# README.md's "Container" section. It only forwards LISTEN_PORT (as the
# container's LISTEN_ADDR), CHALLENGE_KEY, SMTP_HOST, SMTP_PORT, SMTP_USERNAME,
# SMTP_PASSWORD, CONTACT_TO, CONTACT_FROM, UMAMI_URL, UMAMI_WEBSITE_ID and
# FEED_SERVICE_URL into the website container, and POST_COUNT into the
# development only fakefeed container. Every other variable below has no
# effect through that stack; it still documents them for a plain `bin/website`
# run or a Kubernetes Deployment, where these same names are read straight from
# the process environment instead. See internal/config for the full validation.
#
# Every secret-shaped variable below also accepts a "_FILE" twin that names a
# path instead of the value itself: the server reads that file's content
# (trimmed of a trailing newline) as the value. For example, CHALLENGE_KEY_FILE
# can point at a file an OpenBao agent, External Secrets or a Kubernetes
# secret mount wrote, instead of the value sitting in .env directly. Setting
# both a variable and its "_FILE" twin at the same time is a startup error,
# so a deployment is never in doubt about which one actually won. This is
# also why this application has no secret manager client of its own: the
# "_FILE" convention lets any secret source populate the same variable name,
# as long as it lands the value or the file in place before the process
# starts.

# --- Server ---

# Address the HTTP server listens on. Optional, defaults to :8080. Read by a
# plain `bin/website` run and a Kubernetes Deployment. docker-compose.yaml does
# not forward it: see LISTEN_PORT below.
# LISTEN_ADDR=:8080

# docker-compose.yaml only: the one value that sets both the port the
# container listens on (it passes LISTEN_ADDR=:<port> to the container) and
# the host port it publishes on 127.0.0.1. Optional, defaults to 8080.
# Compose interpolation cannot cut a port out of an address such as :8123, so
# compose takes the port alone. The app itself never reads LISTEN_PORT.
# LISTEN_PORT=8080

# Address of govue's admin listener: /healthz, /readyz and /metrics. Optional,
# defaults to :8081. docker-compose.yaml neither forwards nor publishes it.
# ADMIN_ADDR=:8081

# The site's own canonical origin, used for SEO tags and the sitemap.
# Optional, defaults to https://ostendorf.tech.
# SITE_URL=https://ostendorf.tech

# debug, info, warn or error. Optional, defaults to info.
# LOG_LEVEL=info

# Comma separated CIDRs or addresses trusted to set X-Forwarded-For, so the
# rate limiter and the access log attribute a request to the real visitor
# instead of a reverse proxy in front of this service. Optional with no
# proxy in front of this service; required in practice behind any reverse
# proxy or ingress, since leaving it empty attributes every request to that
# proxy's own address and collapses every rate limit into one shared bucket
# for the whole site. Left commented out here because docker-compose.yaml
# runs with no proxy in front of it.
# TRUSTED_PROXIES=10.0.0.0/8
#
# It also decides which visitor the page view counting below sees: behind a
# proxy without it every request comes from the proxy's private address,
# which is never counted, so nothing is counted.

# --- Page view counting (Umami) ---

# Server side page view counting through govue's analytics package. Nothing
# reaches the visitor's browser: no script, no cookie. Off unless both
# values are set; setting only one stops the start. Neither is a secret, so
# neither needs the _FILE convention.
# Base URL of the Umami instance: https, or plain http for localhost or a
# name inside the cluster.
# UMAMI_URL=
# UUID of the website in Umami.
# UMAMI_WEBSITE_ID=
# Optional: bound of one post to Umami (1s to 30s, default 5s) and the number
# of views that may wait for a worker (1 to 10000, default 256).
# UMAMI_TIMEOUT=5s
# UMAMI_QUEUE_SIZE=256

# Drops the Strict-Transport-Security header, for a plain HTTP development
# run only. Optional, defaults to false. Never set this on anything reachable
# from outside the machine it runs on. docker-compose.yaml already hardcodes
# this to true for its own container, so it has no effect there; it matters
# for running bin/website directly over plain HTTP instead.
# ALLOW_PLAIN_HTTP=true

# --- Rate limiting ---

# Requests one client address may make before waiting, and that burst's
# refill period. Optional, default to 120 per 1m. Applies to every route,
# the two contact form routes included.
# RATE_LIMIT_BURST=120
# RATE_LIMIT_PER=1m

# Challenge requests (GET /api/v1/contact/challenge) one client address may
# make before waiting, and that burst's refill period. Optional, default to
# 10 per 20s, govue's own default.
# CHALLENGE_RATE_LIMIT_BURST=10
# CHALLENGE_RATE_LIMIT_PER=20s

# Contact submissions (POST /api/v1/contact) one client address may make
# before waiting, and that burst's refill period. Optional, default to 5
# per 10m, govue's own default.
# CONTACT_RATE_LIMIT_BURST=5
# CONTACT_RATE_LIMIT_PER=10m

# Contact mails this service sends in total, across every client address,
# before waiting, and that burst's refill period. Optional, default to 50 per
# 1h, govue's own default. The burst is 1 to 100000, the period 1s to 24h.
# MAIL_RATE_LIMIT_BURST=50
# MAIL_RATE_LIMIT_PER=1h

# --- Contact form: proof of work ---

# Signs the contact form's proof of work challenge. Hex encoded, at least 32
# bytes (64 hex characters). Optional: without it the contact form answers
# 503 not_configured; every other page still works. Generate one with:
# openssl rand -hex 32
CHALLENGE_KEY=
# CHALLENGE_KEY_FILE=/run/secrets/challenge_key

# Only while rotating CHALLENGE_KEY: the key it held before, so a challenge
# issued just before the rotation still verifies. Same format as
# CHALLENGE_KEY. Setting it without CHALLENGE_KEY is a startup error. Remove it
# once the challenge lifetime (10 minutes) has passed. See README.md.
# CHALLENGE_KEY_PREVIOUS=
# CHALLENGE_KEY_PREVIOUS_FILE=/run/secrets/challenge_key_previous

# --- Contact form: mail ---

# SMTP submission server the contact form sends through, read by govue's
# mail.LoadConfig. SMTP_HOST is a bare host name, no port. Optional: unset,
# the contact form answers 503 not_configured; every other page still works.
# SMTP_PORT defaults to 587 with STARTTLS required; 465 means TLS from the
# first byte.
SMTP_HOST=
# SMTP_PORT=587

# SMTP credentials, both or neither. SMTP_PASSWORD also accepts a _FILE twin.
# SMTP_USERNAME has none in govue v0.6.0: set it as a plain variable.
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Recipient address of every contact mail, and the envelope sender address.
# Optional, default to simon@ostendorf.tech and
# "ostendorf.tech <no-reply@ostendorf.cloud>".
# CONTACT_TO=simon@ostendorf.tech
# CONTACT_FROM=ostendorf.tech <no-reply@ostendorf.cloud>

# --- Feed: Impressionen section ---

# Origin of the feed service the home page's Impressionen section is loaded
# from, http or https, with no credentials, query or fragment. Optional:
# unset or empty switches the section off, so the page renders no
# Impressionen section at all and the rest of the page is unaffected.
#
# The example port is 9081 on purpose: 8081 is the website's own admin
# listener (ADMIN_ADDR), so pointing this at it would ask the website for its
# own health endpoint. The feed service itself defaults to :8081, so on one
# machine run it with LISTEN_ADDR=:9081 (see the feed section below). In a
# cluster the Helm chart computes this value itself.
# FEED_SERVICE_URL=http://localhost:9081
#
# docker-compose.yaml only: to see the section locally, start the stack with
# "docker compose --profile feed up --build" and set
# FEED_SERVICE_URL=http://fakefeed:9081
# The fakefeed service (cmd/fakefeed, development only) serves generated sample
# posts, never real Instagram content. The real feed service cannot run
# locally, since it needs OpenBao and a Meta token. The port must match the
# one fakefeed listens on in docker-compose.yaml; internal/envsync checks it.
# Without the profile leave FEED_SERVICE_URL unset: the section stays off.

# How often the website asks the feed service for the post list. Optional,
# defaults to 5m. Must be between 1m and 24h; a value outside that range is a
# startup error. Has no effect while FEED_SERVICE_URL is unset.
# FEED_REFRESH_INTERVAL=5m

# --- Feed service (cmd/feed, a separate binary and image) ---

# The variables below are read by the feed service only, never by the website,
# and docker-compose.yaml runs no real feed service, only the fake one above
# (its own LISTEN_ADDR is set in the compose file, and compose forwards
# POST_COUNT below to it). docker-compose.yaml forwards none of the OpenBao
# variables: the fake feed needs no OpenBao. They live in the feed service's
# own environment. See internal/feedconfig. The Instagram access token itself
# lives in OpenBao, never here.
#
# The feed service also reads LISTEN_ADDR and LOG_LEVEL under the same names
# as above, with its own default for LISTEN_ADDR: :8081. That is the website's
# default ADMIN_ADDR, so run both on one machine only with one of the two
# changed.
#
# A local run of the real feed service (go run ./cmd/feed) against a
# development OpenBao uses the token method:
#   OPENBAO_AUTH_METHOD=token
#   OPENBAO_ADDR=http://127.0.0.1:8200
#   OPENBAO_TOKEN=<a token allowed to read and write OPENBAO_SECRET_PATH>
#   (or OPENBAO_TOKEN_FILE=<path of a file holding it>)
#   OPENBAO_SECRET_PATH=<KV v2 data path of the secret>
#   OPENBAO_SECRET_KEY_ACCESS_TOKEN and OPENBAO_SECRET_KEY_REFRESHED_AT
#   only when the secret uses other key names than the defaults
#   LISTEN_ADDR=:9081
# A token in .env is a secret. .env stays git ignored and must never be
# committed. The token is never renewed: once it expires or is revoked,
# every OpenBao request answers 403, /readyz stays 503, and the process
# needs a new token and a restart.

# OpenBao address, http or https. Required for every auth method.
# OPENBAO_ADDR=https://openbao.example.internal:8200

# How the feed service logs in to OpenBao: kubernetes or token. Optional,
# defaults to kubernetes, the method for a cluster. token is for a local run.
# Any other value is a startup error.
# OPENBAO_AUTH_METHOD=kubernetes

# kubernetes method only. Setting any of these three with
# OPENBAO_AUTH_METHOD=token is a startup error.
# Name of the OpenBao Kubernetes auth role to log in as. Required.
# OPENBAO_ROLE=ostendorf-tech-feed
# Path of the file holding the service account token used to log in.
# Required.
# OPENBAO_JWT_FILE=/var/run/secrets/openbao/token
# Mount path of the Kubernetes auth method. Optional, defaults to kubernetes.
# OPENBAO_AUTH_PATH=kubernetes

# token method only, and required there. A secret: it also accepts the
# OPENBAO_TOKEN_FILE twin, and setting both is a startup error. Setting
# either with OPENBAO_AUTH_METHOD=kubernetes is a startup error too. The
# token is sent as X-Vault-Token on every request and never renewed.
# OPENBAO_TOKEN=
# OPENBAO_TOKEN_FILE=/run/secrets/openbao_token

# KV v2 data path of the secret that holds the Instagram access token.
# Optional, defaults to instagram.com/api-tokens/data/simonostendorf.vtech.
# OPENBAO_SECRET_PATH=instagram.com/api-tokens/data/simonostendorf.vtech

# Names of the two keys inside that secret: the Instagram access token and
# the RFC 3339 time it was last refreshed. Optional, default to access_token
# and refreshed_at. A refresh rewrites only these two keys and keeps every
# other key of the secret. A name that is blank, contains "/" or a control
# character, or is the same for both, is a startup error.
# OPENBAO_SECRET_KEY_ACCESS_TOKEN=access_token
# OPENBAO_SECRET_KEY_REFRESHED_AT=refreshed_at

# How often the feed is reloaded from Meta. Optional, defaults to 1h. Must be
# between 1m and 24h.
# SYNC_INTERVAL=1h

# Token age after which a refresh is tried. Optional, defaults to 7d. Must be
# between 24h and 50d. The "d" suffix means days.
# TOKEN_REFRESH_AGE=7d

# Graph API version calls are made against. Optional, defaults to v23.0.
# API_VERSION=v23.0

# Number of posts asked for per sync. Optional, defaults to 20. Must be
# between 1 and 100.
# POST_COUNT=20
