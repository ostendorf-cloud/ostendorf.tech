# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# Signs the contact form's per-session CSRF token. Required: the server
# refuses to start without it. Generate one with: openssl rand -hex 32
CSRF_KEY=

# Optional: signs the contact form's proof of work challenge. Without it the
# contact form answers "unavailable"; every other page still works.
# Generate one with: openssl rand -hex 32
CHALLENGE_KEY=

# Optional: the mail submission server and credentials the contact form
# sends through. Without a username and password the contact form answers
# "unavailable"; every other page still works.
# SMTP_ADDR=mail.ostendorf.cloud:587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: override the contact form's fixed addresses.
# CONTACT_TO=simon@ostendorf.tech
# CONTACT_FROM=ostendorf.tech <no-reply@ostendorf.cloud>
