# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every value below is a placeholder, never a real
# credential.
#
# docker-compose.yaml reads .env for the local development stack; see
# README.md's "Container" section. It only forwards CSRF_KEY, CHALLENGE_KEY,
# SMTP_ADDR, SMTP_USERNAME, SMTP_PASSWORD, CONTACT_TO and CONTACT_FROM into
# the container today, so every other variable below has no effect through
# that stack; it still documents them for a plain `bin/website` run or a
# Kubernetes Deployment, where these same names are read straight from the
# process environment instead. See internal/config for the full validation.
#
# Every secret-shaped variable below also accepts a "_FILE" twin that names a
# path instead of the value itself: the server reads that file's content
# (trimmed of a trailing newline) as the value. For example, CSRF_KEY_FILE
# can point at a file an OpenBao agent, External Secrets or a Kubernetes
# secret mount wrote, instead of the value sitting in .env directly. Setting
# both a variable and its "_FILE" twin at the same time is a startup error,
# so a deployment is never in doubt about which one actually won. This is
# also why this application has no secret manager client of its own: the
# "_FILE" convention lets any secret source populate the same variable name,
# as long as it lands the value or the file in place before the process
# starts.

# --- Server ---

# Address the HTTP server listens on. Optional, defaults to :8080.
# LISTEN_ADDR=:8080

# The site's own canonical origin, used for SEO tags and the sitemap.
# Optional, defaults to https://ostendorf.tech.
# SITE_URL=https://ostendorf.tech

# debug, info, warn or error. Optional, defaults to info.
# LOG_LEVEL=info

# Comma separated CIDRs or addresses trusted to set X-Forwarded-For, so the
# rate limiter and the access log attribute a request to the real visitor
# instead of a reverse proxy in front of this service. Optional with no
# proxy in front of this service; required in practice behind any reverse
# proxy or ingress, since leaving it empty attributes every request to that
# proxy's own address and collapses every rate limit into one shared bucket
# for the whole site. Left commented out here because docker-compose.yaml
# runs with no proxy in front of it.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
#
# It also decides which visitor the page view counting below sees: behind a
# proxy without it every request comes from the proxy's private address,
# which is never counted, so nothing is counted.

# --- Page view counting (Umami) ---

# Server side page view counting through govue's analytics package. Nothing
# reaches the visitor's browser: no script, no cookie. Off unless both
# values are set; setting only one stops the start. Neither is a secret, so
# neither needs the _FILE convention.
# Base URL of the Umami instance: https, or plain http for localhost or a
# name inside the cluster.
# UMAMI_URL=
# UUID of the website in Umami.
# UMAMI_WEBSITE_ID=
# Optional: bound of one post to Umami (1s to 30s, default 5s) and the number
# of views that may wait for a worker (1 to 10000, default 256).
# UMAMI_TIMEOUT=5s
# UMAMI_QUEUE_SIZE=256

# Drops the session cookie's Secure attribute, for a plain HTTP development
# run only. Optional, defaults to false. Never set this on anything reachable
# from outside the machine it runs on. docker-compose.yaml already hardcodes
# this to true for its own container, so it has no effect there; it matters
# for running bin/website directly over plain HTTP instead.
# ALLOW_PLAIN_HTTP=true

# --- CSRF ---

# Signs the contact form's per-session CSRF token. Hex encoded, at least 32
# bytes (64 hex characters). Required: the server refuses to start without
# it. Generate one with: openssl rand -hex 32
CSRF_KEY=
# CSRF_KEY_FILE=/run/secrets/csrf_key

# --- Rate limiting ---

# Requests one client address may make before waiting, and that burst's
# refill period. Optional, default to 120 per 1m.
# RATE_LIMIT_BURST=120
# RATE_LIMIT_PER=1m

# Challenge requests (GET /api/v1/challenge) one client address may make
# before waiting, and that burst's refill period. Optional, default to 10
# per 20s.
# CHALLENGE_RATE_LIMIT_BURST=10
# CHALLENGE_RATE_LIMIT_PER=20s

# Contact submissions (POST /api/v1/contact) one client address may make
# before waiting, and that burst's refill period. Optional, default to 5
# per 10m.
# CONTACT_RATE_LIMIT_BURST=5
# CONTACT_RATE_LIMIT_PER=10m

# --- Contact form: proof of work ---

# Signs the contact form's proof of work challenge. Hex encoded, at least 32
# bytes (64 hex characters). Optional: without it the contact form answers
# "unavailable" in both locales; every other page still works. Generate one
# with: openssl rand -hex 32
CHALLENGE_KEY=
# CHALLENGE_KEY_FILE=/run/secrets/challenge_key

# --- Contact form: mail ---

# SMTP submission server the contact form sends through. Optional, defaults
# to mail.ostendorf.cloud:587.
# SMTP_ADDR=mail.ostendorf.cloud:587

# SMTP credentials. Optional as a pair: without both set, the contact form
# answers "unavailable" in both locales; every other page still works.
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_USERNAME_FILE=/run/secrets/smtp_username
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Recipient address of every contact mail, and the envelope sender address.
# Optional, default to simon@ostendorf.tech and
# "ostendorf.tech <no-reply@ostendorf.cloud>".
# CONTACT_TO=simon@ostendorf.tech
# CONTACT_FROM=ostendorf.tech <no-reply@ostendorf.cloud>
