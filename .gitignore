# macOS
.DS_Store

# Local secrets for docker compose; see .env.example.
.env

# Agents
.claude/settings.local.json
.claude/.cc-writes/
.claude/worktrees/

# Go
*.exe
*.test
*.out
*.prof
coverage.out
bin/

# The built SPA and the prerendered HTML it embeds: both are generated by
# task web:build and task prerender, never written by hand or committed.
cmd/website/dist/
cmd/website/prerendered/

# Node, for the web/ package
node_modules/
dist/
coverage/
*.log
*.tsbuildinfo
.eslintcache
web/test-results/
web/playwright-report/

# pnpm puts its store inside the project when the global one is not writable,
# which is what a sandboxed run does.
.pnpm-store/

# Task's scratch directory. `task test:helm` builds a helm plugin directory here
# rather than relying on helm's own, which a cached tool install never populates.
.task/
